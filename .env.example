# 8xSentinel App Environment Configuration
# Copy this file to '.env' and populate with actual credentials.

# ─────────────────────────────────────────────
# Clerk Authentication
# Find these in: Clerk Dashboard → API Keys
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ─────────────────────────────────────────────
# Convex Backend
# Auto-populated by: npx convex dev
# Find manually in: Convex Dashboard → Settings
# ─────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ─────────────────────────────────────────────
# Convex + Clerk JWT Integration
# Required for Convex to validate Clerk JWTs
# Find in: Clerk Dashboard → JWT Templates → Convex
# ─────────────────────────────────────────────
CLERK_ISSUER_URL=https://your-clerk-frontend-api.clerk.accounts.dev
